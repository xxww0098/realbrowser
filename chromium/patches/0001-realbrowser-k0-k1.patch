+  CHECK_EQ(persona.FindInt("schema_version").value_or(-1),
+           kRealBrowserPersonaSchemaVersion);
+  const std::string* persona_id = persona.FindString("persona_id");
+  CHECK(persona_id && !persona_id->empty());
+  CHECK_EQ(persona.FindInt("engine_major").value_or(-1),
+           version_info::GetMajorVersionNumberAsInt());
+  const base::Value::Dict* surfaces = persona.FindDict("surfaces");
+  CHECK(surfaces && HasExactlyKeys(*surfaces, {"canvas"}));
+  const base::Value::Dict* canvas = surfaces->FindDict("canvas");
+  CHECK(canvas && HasExactlyKeys(*canvas, {"mode"}));
+  const std::string* canvas_mode = canvas->FindString("mode");
+  CHECK(canvas_mode && *canvas_mode == "seeded_noise");
+  const std::string* seed = persona.FindString("seed");
+  CHECK(seed && IsHexSeed(*seed));
+  command_line->AppendSwitchASCII(kRealBrowserCanvasSeedSwitch, *seed);
+}
