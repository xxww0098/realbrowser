new file mode 100644
index 00000000..5f49415b
--- /dev/null
+++ b/third_party/blink/renderer/platform/graphics/realbrowser_canvas_noise.cc
@@ -0,0 +1,168 @@
+// Copyright 2026 The RealBrowser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/platform/graphics/realbrowser_canvas_noise.h"
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string_view>
+
+#include "base/check.h"
+#include "base/command_line.h"
+#include "base/compiler_specific.h"
+#include "base/containers/span.h"
+#include "third_party/blink/renderer/platform/graphics/static_bitmap_image.h"
+#include "third_party/blink/renderer/platform/graphics/unaccelerated_static_bitmap_image.h"
+#include "third_party/skia/include/core/SkColorType.h"
+#include "third_party/skia/include/core/SkData.h"
+#include "third_party/skia/include/core/SkImage.h"
+#include "third_party/skia/include/core/SkImageInfo.h"
+#include "third_party/skia/include/core/SkPixmap.h"
+
+namespace blink {
+namespace {
+
+constexpr char kCanvasSeedSwitch[] = "realbrowser-canvas-seed";
+constexpr size_t kSeedBytes = 32;
+constexpr size_t kPerturbedPixels = 8;
+
+int HexDigit(char value) {
+  if (value >= '0' && value <= '9') {
+    return value - '0';
+  }
+  if (value >= 'a' && value <= 'f') {
+    return value - 'a' + 10;
+  }
+  if (value >= 'A' && value <= 'F') {
+    return value - 'A' + 10;
+  }
+  return -1;
+}
+
+std::optional<std::array<uint8_t, kSeedBytes>> ParseSeed(
+    std::string_view value) {
+  if (value.size() != kSeedBytes * 2) {
+    return std::nullopt;
+  }
+  std::array<uint8_t, kSeedBytes> seed{};
+  for (size_t index = 0; index < seed.size(); ++index) {
+    const int high = HexDigit(value[index * 2]);
+    const int low = HexDigit(value[index * 2 + 1]);
+    if (high < 0 || low < 0) {
+      return std::nullopt;
+    }
+    seed[index] = static_cast<uint8_t>((high << 4) | low);
+  }
+  return seed;
+}
+
+const std::optional<std::array<uint8_t, kSeedBytes>>& CanvasSeed() {
+  static const std::optional<std::array<uint8_t, kSeedBytes>> seed = [] {
+    const base::CommandLine& command_line =
+        *base::CommandLine::ForCurrentProcess();
+    if (!command_line.HasSwitch(kCanvasSeedSwitch)) {
+      return std::optional<std::array<uint8_t, kSeedBytes>>();
+    }
+    auto parsed = ParseSeed(
+        command_line.GetSwitchValueASCII(kCanvasSeedSwitch));
+    CHECK(parsed.has_value());
+    return parsed;
+  }();
+  return seed;
+}
+
+uint64_t Mix(uint64_t value) {
+  value += 0x9e3779b97f4a7c15ULL;
+  value = (value ^ (value >> 30)) * 0xbf58476d1ce4e5b9ULL;
+  value = (value ^ (value >> 27)) * 0x94d049bb133111ebULL;
+  return value ^ (value >> 31);
+}
+
+uint64_t SeedState(const std::array<uint8_t, kSeedBytes>& seed,
+                   int width,
+                   int height) {
+  uint64_t state = 0x7265616c62726f77ULL;
+  for (uint8_t byte : seed) {
+    state = Mix(state ^ byte);
+  }
+  return Mix(state ^ (static_cast<uint64_t>(width) << 32) ^
+             static_cast<uint32_t>(height));
+}
+
+}  // namespace
+
+void ApplyRealBrowserCanvasNoise(SkPixmap& pixmap) {
+  const auto& seed = CanvasSeed();
+  if (!seed.has_value() || pixmap.width() <= 0 || pixmap.height() <= 0 ||
+      pixmap.addr() == nullptr || pixmap.writable_addr() == nullptr) {
+    return;
+  }
+  if (pixmap.colorType() != kRGBA_8888_SkColorType &&
+      pixmap.colorType() != kBGRA_8888_SkColorType) {
+    return;
+  }
+
+  const size_t pixel_count =
+      static_cast<size_t>(pixmap.width()) * pixmap.height();
+  const size_t perturbation_count =
+      std::min(kPerturbedPixels, pixel_count);
+  std::array<size_t, kPerturbedPixels> used{};
+  uint64_t state = SeedState(*seed, pixmap.width(), pixmap.height());
+
+  for (size_t sample = 0; sample < perturbation_count; ++sample) {
+    state = Mix(state ^ sample);
+    size_t pixel_index = state % pixel_count;
+    while (std::find(used.begin(), used.begin() + sample, pixel_index) !=
+           used.begin() + sample) {
+      pixel_index = (pixel_index + 1) % pixel_count;
+    }
+    used[sample] = pixel_index;
+    const int x = static_cast<int>(pixel_index % pixmap.width());
+    const int y = static_cast<int>(pixel_index / pixmap.width());
+    auto pixel = UNSAFE_BUFFERS(base::span(
+        static_cast<uint8_t*>(pixmap.writable_addr(x, y)), size_t{4}));
+    const size_t channel = Mix(state ^ 0x63616e766173ULL) % 3;
+    pixel[channel] ^= 1;
+  }
+}
+
+scoped_refptr<StaticBitmapImage> CopyWithRealBrowserCanvasNoise(
+    scoped_refptr<StaticBitmapImage> image) {
+  if (!image || !CanvasSeed().has_value()) {
+    return image;
+  }
+  PaintImage paint_image = image->PaintImageForCurrentFrame();
+  if (!paint_image || paint_image.IsPaintWorklet()) {
+    return image;
+  }
+  const SkImageInfo source_info = paint_image.GetSkImageInfo();
+  if (source_info.isEmpty()) {
+    return image;
+  }
+  const SkImageInfo copy_info =
+      SkImageInfo::Make(source_info.width(), source_info.height(),
+                        kRGBA_8888_SkColorType, kUnpremul_SkAlphaType,
+                        source_info.refColorSpace());
+  const size_t row_bytes = copy_info.minRowBytes();
+  const size_t byte_size = copy_info.computeByteSize(row_bytes);
+  if (SkImageInfo::ByteSizeOverflowed(byte_size)) {
+    return image;
+  }
+  sk_sp<SkData> data = SkData::MakeUninitialized(byte_size);
+  SkPixmap pixmap(copy_info, data->writable_data(), row_bytes);
+  if (!paint_image.readPixels(copy_info, pixmap.writable_addr(), row_bytes, 0,
+                              0)) {
+    return image;
+  }
+  ApplyRealBrowserCanvasNoise(pixmap);
+  sk_sp<SkImage> copy =
+      SkImages::RasterFromData(copy_info, std::move(data), row_bytes);
+  return copy ? UnacceleratedStaticBitmapImage::Create(std::move(copy))
+              : image;
+}
+
+}  // namespace blink
